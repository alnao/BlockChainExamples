{
  "name": "simple-dex-amm",
  "version": "1.0.0",
  "description": "Simple DEX AMM Example",
  "scripts": {
    "test": "npx hardhat test",
    "compile": "npx hardhat compile",
    "node": "npx hardhat node",
    "deploy": "npx hardhat run scripts/deploy.js",
    "deploy:local": "npx hardhat run scripts/deploy.js --network localhost",
    "interact": "npx hardhat run scripts/interact.js",
    "interact:local": "npx hardhat run scripts/interact.js --network localhost",
    "fund:local": "npx hardhat run scripts/fund.js --network localhost",
    "generate-keys": "npx hardhat run --no-compile scripts/generate-keys.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0"
  }
}
