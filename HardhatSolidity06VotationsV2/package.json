{
    "name": "hardhat-voting-system",
    "version": "2.0.0",
    "description": "Sistema di votazione decentralizzato su Ethereum - Hardhat v3 + viem",
    "type": "module",
    "scripts": {
        "compile": "hardhat compile",
        "test":    "hardhat test",

        "node":    "hardhat node",

        "deploy:local":   "hardhat ignition deploy ignition/modules/AdvancedVotingSystem.js --network localhost && node scripts/post-deploy.js",
        "deploy:edr":     "hardhat ignition deploy ignition/modules/AdvancedVotingSystem.js --network hardhatMainnet && node scripts/post-deploy.js",
        "deploy:sepolia": "hardhat ignition deploy ignition/modules/AdvancedVotingSystem.js --network sepolia && node scripts/post-deploy.js",

        "accounts":          "hardhat run scripts/show-accounts.js     --network localhost",
        "create-voting":     "hardhat run scripts/create-voting.js     --network localhost",
        "register-candidate":"hardhat run scripts/register-candidate.js --network localhost",
        "start-voting":      "hardhat run scripts/start-voting.js      --network localhost",
        "vote":              "hardhat run scripts/vote.js               --network localhost",
        "end-voting":        "hardhat run scripts/end-voting.js        --network localhost",
        "stats":             "hardhat run scripts/get-voting-stats.js  --network localhost",
        "withdraw":          "hardhat run scripts/withdraw-funds.js    --network localhost",
        "change-admin":      "hardhat run scripts/change-admin.js      --network localhost"
    },
    "keywords": ["ethereum","solidity","hardhat","blockchain","smart-contract","voting","viem"],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@nomicfoundation/hardhat-ignition":        "^3.0.6",
        "@nomicfoundation/hardhat-ignition-viem":   "^3.0.6",
        "@nomicfoundation/hardhat-keystore":        "^3.0.3",
        "@nomicfoundation/hardhat-network-helpers": "^3.0.3",
        "@nomicfoundation/hardhat-node-test-runner":"^3.0.8",
        "@nomicfoundation/hardhat-toolbox-viem":    "^5.0.1",
        "@nomicfoundation/hardhat-verify":          "^3.0.8",
        "@nomicfoundation/hardhat-viem":            "^3.0.1",
        "@nomicfoundation/hardhat-viem-assertions": "^3.0.4",
        "hardhat":                                   "^3.1.3",
        "viem":                                      "^2.44.1"
    },
    "dependencies": {
        "dotenv": "^16.6.1"
    }
}
